<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:gravity="center"
    android:padding="24dp">

    <TextView
        android:id="@+id/tvAppTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="16dp"
        android:text="Transport Cost Comparator"
        android:textSize="28sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/tvWelcomeMessage"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Welcome To the Transport Cost Comparator App"
        android:textAlignment="center"
        android:textSize="16sp"
        android:layout_marginBottom="32dp" />

    <Button
        android:id="@+id/btnStartCalc"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Start Calculation"
        android:layout_marginBottom="16dp" />

    <Button
        android:id="@+id/btnListenToMe"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Listen to Me"
        android:layout_marginBottom="16dp" />

    <Button
        android:id="@+id/btnExit"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Exit"
        style="@style/Widget.MaterialComponents.Button.OutlinedButton" />

</LinearLayout>