<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#000000">

    <!-- Top Navigation Bar -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:background="#DC3D3D"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingHorizontal="16dp">

        <TextView android:id="@+id/navHome" android:text="Home" android:textColor="#000000" android:textSize="16sp" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginEnd="24dp"/>
        <TextView android:id="@+id/navDetails" android:text="Details" android:textColor="#000000" android:textSize="16sp" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginEnd="24dp"/>
        <TextView android:id="@+id/navReport" android:text="Report" android:textColor="#000000" android:textSize="16sp" android:layout_width="wrap_content" android:layout_height="wrap_content"/>
        <View android:layout_width="0dp" android:layout_height="0dp" android:layout_weight="1"/>
        <ImageView android:id="@+id/navHelp" android:layout_width="28dp" android:layout_height="28dp" android:src="@android:drawable/ic_menu_help" android:contentDescription="Help"/>
    </LinearLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:padding="24dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center_horizontal">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="TRANSPORT REPORT"
                android:textSize="16sp"
                android:textStyle="bold"
                android:textColor="#FFFFFF"
                android:layout_marginTop="16dp"
                android:layout_marginBottom="36dp"/>

            <!-- Result Rows -->
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:layout_marginBottom="16dp">
                <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="Mode of Transport" android:textColor="#FFFFFF" android:textStyle="bold" android:textSize="14sp"/>
                <TextView android:id="@+id/tvResModeOfTransport" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Private Car" android:textColor="#888888" android:textSize="14sp"/>
            </LinearLayout>

            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:layout_marginBottom="16dp">
                <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="Daily Transport Cost" android:textColor="#FFFFFF" android:textStyle="bold" android:textSize="14sp"/>
                <TextView android:id="@+id/tvResDailyCost" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="R300" android:textColor="#888888" android:textSize="14sp"/>
            </LinearLayout>

            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:layout_marginBottom="16dp">
                <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="Monthly Transport Cost" android:textColor="#FFFFFF" android:textStyle="bold" android:textSize="14sp"/>
                <TextView android:id="@+id/tvResMonthlyCost" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="R6000" android:textColor="#888888" android:textSize="14sp"/>
            </LinearLayout>

            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:layout_marginBottom="16dp">
                <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="Monthly Distance Travelled" android:textColor="#FFFFFF" android:textStyle="bold" android:textSize="14sp"/>
                <TextView android:id="@+id/tvResMonthlyDistance" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="3000 KM" android:textColor="#888888" android:textSize="14sp"/>
            </LinearLayout>

            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:layout_marginBottom="24dp">
                <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="Transport Cost Category" android:textColor="#FFFFFF" android:textStyle="bold" android:textSize="14sp"/>
                <TextView android:id="@+id/tvResCategory" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="VERY HIGH" android:textColor="#888888" android:textStyle="bold" android:textSize="14sp"/>
            </LinearLayout>

            <!-- Recommendation Box -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@drawable/bg_rounded_black_box"
                android:padding="16dp"
                android:layout_marginBottom="32dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Recommendation"
                    android:textColor="#FFFFFF"
                    android:textStyle="bold"
                    android:textSize="14sp"
                    android:layout_gravity="center_horizontal"
                    android:layout_marginBottom="8dp"/>

                <TextView
                    android:id="@+id/tvResRecommendation"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Use public transport where practical.\n\nKeep the vehicle well maintained to improve fuel efficiency."
                    android:textColor="#FFFFFF"
                    android:textSize="13sp"/>
            </LinearLayout>

            <Button
                android:id="@+id/btnCalcAgain"
                android:layout_width="260dp"
                android:layout_height="54dp"
                android:text="Calculate Again"
                android:textColor="#FFFFFF"
                android:textSize="16sp"
                android:textStyle="bold"
                android:background="@drawable/bg_rounded_button"
                android:layout_marginBottom="16dp"
                android:stateListAnimator="@null"/>

            <Button
                android:id="@+id/btnResultsExit"
                android:layout_width="160dp"
                android:layout_height="50dp"
                android:text="Exit"
                android:textColor="#FFFFFF"
                android:textSize="16sp"
                android:textStyle="bold"
                android:background="@drawable/bg_rounded_button"
                android:stateListAnimator="@null"/>

        </LinearLayout>
    </ScrollView>
</LinearLayout>